{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Full title of the paper."
    },
    "studySummary": {
      "type": "string",
      "description": "A concise two-sentence summary of the key findings."
    },
    "articleType": {
      "type": "string",
      "description": "e.g. 'Research Article', 'Review Article', 'Case Report'."
    },
    "studyTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. 'in vivo', 'in vitro', 'in silico'."
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Biological systems/species, e.g. 'rat', 'Sprague-Dawley rat'."
    },
    "ratStrain": {
      "type": "string",
      "description": "Rat strain used, e.g. 'Sprague-Dawley', 'Wistar', 'Long-Evans', or 'Not Applicable'."
    },
    "chemicals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Substances evaluated."
    },
    "doses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tested doses with units, e.g. '10 mg/kg/day', '100 mg/kg bw', '0 (control)'."
    },
    "exposureDuration": {
      "type": "string",
      "description": "Exposure duration / window, e.g. '28 days', 'GD6–PND21'."
    },
    "exposureType": {
      "type": "string",
      "description": "e.g. 'Acute', 'Subacute', 'Subchronic', 'Chronic', 'Developmental'."
    },
    "routeOfAdministration": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Route of administration, e.g. 'Oral gavage', 'Diet', 'Drinking water', 'Subcutaneous injection'."
    },
    "hasTranscriptomics": {
      "type": "boolean",
      "description": "True if the study uses transcriptomics (RNA-Seq, microarrays, qPCR profiling)."
    },
    "noaelValues": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "NOAEL values with units and the endpoint they refer to, or empty if not reported."
    },
    "loaelValues": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "LOAEL values with units and the endpoint they refer to, or empty if not reported."
    },
    "ld50Values": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "LD50 values per chemical with units, or empty if not reported."
    },
    "estrogenConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence statement on estrogen-signalling markers (ERα/esr1, ERβ/esr2, aromatase Cyp19a1). 'Not assessed' if none measured."
    },
    "hormoneConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence conclusion on circulating hormone changes (E2, T, etc.). 'Not assessed' if none measured."
    },
    "neuroendocrineConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence statement on neuroendocrine markers (Kiss1, Kiss1r, GnRH). 'Not assessed' if none measured."
    },
    "vtgConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence statement on vitellogenin if measured (uncommon in mammals). 'Not assessed' if not measured."
    },
    "endpoints": {
      "type": "array",
      "description": "Return ONE object for EACH endocrine endpoint the study actually measured — separately per sex and per dose group when the study reports them separately. Cover these endpoint families WHERE MEASURED: (1) VTG — vitellogenin protein or vtg mRNA; (2) Estrogen-signalling genes — ERα (esr1), ERβ (esr2), aromatase Cyp19a1 (or the fish paralogs cyp19a / cyp19b if reported); (3) Hormone levels — Estradiol (E2), Testosterone (T), 11-Ketotestosterone, Progesterone, FSH, LH, T3, T4, Cortisol/Corticosterone, and the E2/T ratio; (4) Neuroendocrine genes — Kiss1, Kiss1r, GnRH (gnrh3). Do NOT create rows for endpoints that were not measured in this study.",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "The specific marker, e.g. 'Estradiol (E2)', 'Testosterone', 'ERα (esr1) mRNA', 'Aromatase (Cyp19a1)', 'Kiss1', 'VTG protein'."
          },
          "category": {
            "type": "string",
            "description": "One of: 'VTG', 'Estrogen signaling', 'Hormone level', 'Neuroendocrine'."
          },
          "sex": {
            "type": "string",
            "description": "'Male', 'Female', 'Both', or 'Pooled'."
          },
          "doseGroup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dose/treatment group this result refers to, e.g. '100 mg/kg/day', or 'Overall' if not dose-resolved."
          },
          "matrix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sample matrix, e.g. 'Plasma', 'Serum', 'Tissue homogenate', or 'NA'."
          },
          "tissue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tissue/organ analysed, e.g. 'Testis', 'Ovary', 'Brain', 'Liver', or 'NA'."
          },
          "direction": {
            "type": "string",
            "description": "Direction of change vs control: 'Increase', 'No change', 'Decrease', or 'N/A'. Do NOT include time or duration."
          },
          "significance": {
            "type": "string",
            "description": "Statistical significance: 'Significant', 'Not Significant', or 'N/A'."
          }
        },
        "required": [
          "endpoint",
          "category",
          "sex",
          "doseGroup",
          "matrix",
          "tissue",
          "direction",
          "significance"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "description": "Verbatim source snippet per field id.",
      "properties": {
        "studySummary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ratStrain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "chemicals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "doses": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exposureDuration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "noaelValues": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaelValues": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ld50Values": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "estrogenConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hormoneConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "neuroendocrineConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vtgConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoints": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "studySummary",
        "ratStrain",
        "chemicals",
        "doses",
        "exposureDuration",
        "noaelValues",
        "loaelValues",
        "ld50Values",
        "estrogenConclusion",
        "hormoneConclusion",
        "neuroendocrineConclusion",
        "vtgConclusion",
        "endpoints"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "studySummary",
    "articleType",
    "studyTypes",
    "systems",
    "ratStrain",
    "chemicals",
    "doses",
    "exposureDuration",
    "exposureType",
    "routeOfAdministration",
    "hasTranscriptomics",
    "noaelValues",
    "loaelValues",
    "ld50Values",
    "estrogenConclusion",
    "hormoneConclusion",
    "neuroendocrineConclusion",
    "vtgConclusion",
    "endpoints",
    "evidence"
  ],
  "additionalProperties": false
}
