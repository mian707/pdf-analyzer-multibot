{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Full title of the paper."
    },
    "studySummary": {
      "type": "string",
      "description": "A concise two-sentence summary of the key findings."
    },
    "articleType": {
      "type": "string",
      "description": "e.g. 'Research Article', 'Review Article', 'Case Report'."
    },
    "studyTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. 'in vivo', 'in vitro', 'in silico'."
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Biological systems, e.g. 'zebrafish', 'zebrafish embryo'."
    },
    "zebrafishStrain": {
      "type": "string",
      "description": "Specific zebrafish strain used, e.g. 'AB', 'TU', 'Wild-type', or 'Not Applicable'."
    },
    "chemicals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Substances evaluated."
    },
    "testedConcentrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tested concentrations with units, e.g. '10 µg/L', '100 nM', '0 (control)'."
    },
    "exposureDuration": {
      "type": "string",
      "description": "Exposure duration, e.g. '96 hpf', '21 days'."
    },
    "exposureType": {
      "type": "string",
      "description": "Exposure classification, e.g. 'Acute', 'Chronic', 'Developmental'."
    },
    "renewal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Solution renewal regime (e.g. 'static', 'semi-static daily', 'flow-through') or 'no information'."
    },
    "hasTranscriptomics": {
      "type": "boolean",
      "description": "True if the study uses transcriptomics (RNA-Seq, microarrays, qPCR profiling)."
    },
    "lc50Values": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "LC50 values per chemical with units, or empty if not reported."
    },
    "ec50Values": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "EC50 values per chemical with units, or empty if not reported."
    },
    "vtgConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence conclusion on vitellogenin (VTG) induction. 'Not assessed' if not measured."
    },
    "estrogenConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence statement on estrogen-signalling markers (erα, erβ, cyp19a, cyp19b). 'Not assessed' if none measured."
    },
    "hormoneConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence conclusion on circulating hormone changes (E2, T, etc.). 'Not assessed' if none measured."
    },
    "neuroendocrineConclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "One-sentence statement on neuroendocrine markers (kiss1, kiss1r, gnrh3). 'Not assessed' if none measured."
    },
    "endpoints": {
      "type": "array",
      "description": "Return ONE object for EACH endocrine endpoint the study actually measured — separately per sex and per treatment/concentration group when the study reports them separately. Cover these endpoint families WHERE MEASURED: (1) VTG — vitellogenin (vtg1) mRNA or VTG protein; (2) Estrogen-signalling genes — esr1 (erα), esr2 (erβ), cyp19a1a (cyp19a, ovarian aromatase), cyp19a1b (cyp19b, brain aromatase); (3) Hormone levels — Estradiol (E2), Testosterone (T), 11-Ketotestosterone, Progestin/17,20β-DHP, FSH, LH, T3, T4, Cortisol, and the E2/T ratio; (4) Neuroendocrine genes — kiss1, kiss1r, gnrh3. Do NOT create rows for endpoints that were not measured in this study.",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "The specific marker, e.g. 'VTG protein', 'vtg1 mRNA', 'esr1 (erα)', 'cyp19a1b (brain aromatase)', 'Estradiol (E2)', 'kiss1'."
          },
          "category": {
            "type": "string",
            "description": "One of: 'VTG', 'Estrogen signaling', 'Hormone level', 'Neuroendocrine'."
          },
          "sex": {
            "type": "string",
            "description": "'Male', 'Female', 'Both', 'Pooled', or 'Larvae'."
          },
          "treatmentGroup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Concentration/treatment group this result refers to, e.g. '10 µg/L', or 'Overall' if not group-resolved."
          },
          "matrix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sample matrix, e.g. 'Whole body homogenate', 'Plasma', 'Tissue', or 'NA'."
          },
          "tissue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tissue/organ analysed, e.g. 'Gonad', 'Brain', 'Liver', 'Whole body', or 'NA'."
          },
          "direction": {
            "type": "string",
            "description": "Direction of change vs control: 'Increase', 'No change', 'Decrease', or 'N/A'. Do NOT include time or duration."
          },
          "significance": {
            "type": "string",
            "description": "Statistical significance: 'Significant', 'Not Significant', or 'N/A'."
          }
        },
        "required": [
          "endpoint",
          "category",
          "sex",
          "treatmentGroup",
          "matrix",
          "tissue",
          "direction",
          "significance"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "description": "Verbatim source snippet per field id.",
      "properties": {
        "studySummary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "zebrafishStrain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "chemicals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "testedConcentrations": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exposureDuration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lc50Values": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ec50Values": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vtgConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "estrogenConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hormoneConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "neuroendocrineConclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoints": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "studySummary",
        "zebrafishStrain",
        "chemicals",
        "testedConcentrations",
        "exposureDuration",
        "lc50Values",
        "ec50Values",
        "vtgConclusion",
        "estrogenConclusion",
        "hormoneConclusion",
        "neuroendocrineConclusion",
        "endpoints"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "studySummary",
    "articleType",
    "studyTypes",
    "systems",
    "zebrafishStrain",
    "chemicals",
    "testedConcentrations",
    "exposureDuration",
    "exposureType",
    "renewal",
    "hasTranscriptomics",
    "lc50Values",
    "ec50Values",
    "vtgConclusion",
    "estrogenConclusion",
    "hormoneConclusion",
    "neuroendocrineConclusion",
    "endpoints",
    "evidence"
  ],
  "additionalProperties": false
}
